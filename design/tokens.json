{
  "$comment": "护肝宝的设计变量，唯一来源（UI v8，2026-11-27 定稿；规范见私有仓库 docs/design/ui-v8/spec.md）。网页的 tokens.css 由 design/tokens.mjs 生成；安卓、Windows 的 Kotlin 主题 DesignTokens.kt 由私有仓库 tools/tokens-kotlin.mjs 生成。颜色分浅色、深色两套，只写 6 位十六进制。文字对比度 ≥4.5:1，图标和控件 ≥3:1。主色只有黑白；彩色只给内容；禁止蓝紫色。",
  "breakpoint": {
    "$comment": "窗口宽度三档：小于 medium 是窄（底部导航），medium 到 wide 之前是中，wide 及以上是宽",
    "medium": 600,
    "wide": 1024
  },
  "color": {
    "bg": {
      "light": "#F7F5F3",
      "dark": "#121010",
      "$comment": "页面"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1C1918",
      "$comment": "卡片、导航条、输入框"
    },
    "sunken": {
      "light": "#F3F0ED",
      "dark": "#242120",
      "$comment": "卡片里的子块、次按钮、未选中的胶囊、骨架、表头"
    },
    "raised": {
      "light": "#FFFFFF",
      "dark": "#2A2625",
      "$comment": "弹层、对话框、菜单、抽屉"
    },
    "line": {
      "light": "#ECE7E3",
      "dark": "#332E2C",
      "$comment": "行间分隔线；卡片不描边"
    },
    "control": {
      "light": "#8F877F",
      "dark": "#78706A",
      "$comment": "输入框边框、开关关闭的轨道，≥3:1"
    },
    "ink": {
      "light": "#1D1A18",
      "dark": "#F2EEEB",
      "$comment": "标题、正文、浅彩上的所有字；进度、运行中的点、已改小点、星标"
    },
    "muted": {
      "light": "#5F5852",
      "dark": "#ABA39D",
      "$comment": "说明、组标题、单位"
    },
    "faint": {
      "light": "#6E6760",
      "dark": "#958D87",
      "$comment": "占位文字，不放在浅彩上"
    },
    "primary": {
      "light": "#1D1A18",
      "dark": "#F2EEEB",
      "$comment": "主色只有黑白：主按钮、选中、开关打开、导航当前项"
    },
    "primary-hover": {
      "light": "#3A3532",
      "dark": "#FFFFFF"
    },
    "on-primary": {
      "light": "#FFFFFF",
      "dark": "#1C1918"
    },
    "primary-soft": {
      "light": "#EFECE9",
      "dark": "#332E2C",
      "$comment": "选中行、底部导航当前项、行尾操作按钮的底"
    },
    "primary-line": {
      "light": "#CFC8C2",
      "dark": "#5A524D",
      "$comment": "选中卡片的描边"
    },
    "focus": {
      "light": "#1D1A18",
      "dark": "#F2EEEB",
      "$comment": "键盘焦点外框"
    },
    "track": {
      "light": "#E4E4E3",
      "dark": "#3E3B3A",
      "$comment": "进度轨道、运行中点的光晕"
    },
    "switch-thumb": {
      "light": "#FFFFFF",
      "dark": "#1C1918",
      "$comment": "开关圆钮，开、关两种轨道上都 ≥3:1"
    },
    "tint-1": {
      "light": "#FDEDE4",
      "dark": "#3A2219",
      "$comment": "分类浅彩 杏 / 珊瑚：日常、主号、战报图表"
    },
    "accent-1": {
      "light": "#E0602F",
      "dark": "#F2A487",
      "$comment": "分类图标色，只画图形不写字"
    },
    "tint-2": {
      "light": "#FCEBF1",
      "dark": "#3A1C28",
      "$comment": "分类浅彩 粉 / 玫红：战斗、通知"
    },
    "accent-2": {
      "light": "#D2497A",
      "dark": "#F29AB9",
      "$comment": "分类图标色，只画图形不写字"
    },
    "tint-3": {
      "light": "#F1F5DF",
      "dark": "#262D14",
      "$comment": "分类浅彩 黄绿 / 橄榄：御魂、小号二、开发者"
    },
    "accent-3": {
      "light": "#6E8C24",
      "dark": "#BFD98A",
      "$comment": "分类图标色，只画图形不写字"
    },
    "tint-4": {
      "light": "#E3F4F1",
      "dark": "#12302C",
      "$comment": "分类浅彩 薄荷 / 青绿：活动、小号一、帮助"
    },
    "accent-4": {
      "light": "#1E9184",
      "dark": "#86D9CB",
      "$comment": "分类图标色，只画图形不写字"
    },
    "tint-5": {
      "light": "#FCF4DC",
      "dark": "#33290F",
      "$comment": "分类浅彩 奶黄 / 芥黄：计划和时间、外观"
    },
    "accent-5": {
      "light": "#B07A0A",
      "dark": "#EBCB7A",
      "$comment": "分类图标色，只画图形不写字"
    },
    "ok": {
      "light": "#1F7A3A",
      "dark": "#5FCB92",
      "$comment": "完成、在线、就绪"
    },
    "warn": {
      "light": "#8A6100",
      "dark": "#F2C553",
      "$comment": "待核对、未开启"
    },
    "danger": {
      "light": "#B0213A",
      "dark": "#FF7A8A",
      "$comment": "失败、离线"
    },
    "on-status": {
      "light": "#FFFFFF",
      "dark": "#1C1918",
      "$comment": "实心状态色圆块上的图标"
    },
    "danger-solid": {
      "light": "#B0213A",
      "dark": "#C42B3F",
      "$comment": "危险确认按钮，配白字"
    },
    "on-danger": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF",
      "$comment": "danger-solid 上的字"
    },
    "inverse": {
      "light": "#2A2522",
      "dark": "#F2EEEB",
      "$comment": "Toast 底"
    },
    "on-inverse": {
      "light": "#F7F3F0",
      "dark": "#1C1918"
    },
    "hero-from": {
      "light": "#FCE3D6",
      "dark": "#3A2219",
      "$comment": "主卡渐变 杏→粉 起点"
    },
    "hero-to": {
      "light": "#F9DDE8",
      "dark": "#3A1C28"
    },
    "hero2-from": {
      "light": "#DDF2EA",
      "dark": "#12302C",
      "$comment": "主卡渐变 薄荷→奶黄 起点"
    },
    "hero2-to": {
      "light": "#FBF0D2",
      "dark": "#33290F"
    },
    "aurora-1": {
      "light": "#FDE3D7",
      "dark": "#2E1913",
      "$comment": "页面顶部极光"
    },
    "aurora-2": {
      "light": "#DCF2E6",
      "dark": "#102520"
    },
    "aurora-3": {
      "light": "#FCF1D2",
      "dark": "#2A2210"
    },
    "aurora-4": {
      "light": "#FBE1EC",
      "dark": "#2A141E"
    },
    "logo-star": {
      "light": "#E0602F",
      "dark": "#E0602F",
      "$comment": "logo 里的星：珊瑚色，浅色主题落在黑底上、深色主题落在白底上（logo 方向 A，2026-11-27 定）"
    }
  },
  "font": {
    "body": "system-ui, -apple-system, \"PingFang SC\", \"Noto Sans SC\", \"Microsoft YaHei\", sans-serif"
  },
  "text": {
    "xs": "12px",
    "sm": "13px",
    "md": "14px",
    "lg": "15px",
    "xl": "17px",
    "2xl": "22px",
    "title": "26px",
    "display": "32px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "28px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "18px",
    "xl": "24px",
    "2xl": "28px",
    "menu": "20px",
    "pill": "999px"
  },
  "control": {
    "height": "40px",
    "height-lg": "48px",
    "height-sm": "36px",
    "icon": "44px",
    "tile": "40px"
  },
  "shadow": {
    "$comment": "只给网页用；App 用 Compose 的阴影和内描边",
    "sm": {
      "light": "0 1px 2px rgba(80,40,20,.04), 0 8px 24px -12px rgba(80,40,20,.12)",
      "dark": "inset 0 0 0 1px rgba(255,255,255,.06), inset 0 1px 0 rgba(255,255,255,.05)"
    },
    "md": {
      "light": "0 12px 32px -12px rgba(80,40,20,.22)",
      "dark": "inset 0 0 0 1px rgba(255,255,255,.07), 0 8px 24px rgba(0,0,0,.5)"
    },
    "lg": {
      "light": "0 24px 64px -16px rgba(80,40,20,.32)",
      "dark": "inset 0 0 0 1px rgba(255,255,255,.08), 0 24px 64px rgba(0,0,0,.6)"
    }
  },
  "motion": {
    "$comment": "只给网页用",
    "fast": "120ms",
    "base": "200ms",
    "enter": "280ms",
    "exit": "180ms",
    "ease": "cubic-bezier(.2,0,0,1)",
    "ease-exit": "cubic-bezier(.3,0,1,1)"
  }
}
