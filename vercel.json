{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "console": {
      "root": "client/console",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build && find dist -name '*.map' -delete",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/console/:path((?!assets/).*)",
          "destination": "/console/index.html"
        }
      ],
      "headers": [
        {
          "source": "/console/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    "admin": {
      "root": "client/admin",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build && find dist -name '*.map' -delete",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/admin/:path((?!assets/).*)",
          "destination": "/admin/index.html"
        }
      ],
      "headers": [
        {
          "source": "/admin/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/admin/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://api-hgb.l2cl.link; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            }
          ]
        }
      ]
    },
    "docs": {
      "root": "client/docs",
      "framework": "astro",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist",
      "headers": [
        {
          "source": "/_astro/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "docs"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
