---
// The docs' title opens the docs' first page, with the console (the site's "/") beside it, as in the design.
import Default from "@astrojs/starlight/components/SiteTitle.astro";
---
<div class="titles">
  <Default {...Astro.props} />
  <a class="console" href="/">控制台</a>
</div>
<style>
  .titles { display: flex; align-items: center; gap: 1rem; }
  .console { display: none; }
  @media (min-width: 50rem) {
    .console { display: inline-flex; align-items: center; min-height: 2.25rem; padding: 0 0.875rem; border-radius: 10px; background: var(--color-primary);
      color: var(--color-on-primary); font-weight: 600; text-decoration: none; white-space: nowrap; font-size: 0.875rem; }
  }
</style>
